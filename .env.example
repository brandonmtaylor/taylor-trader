# Copy to .env (git-ignored) or, better, store these in the macOS Keychain:
#   security add-generic-password -s taylortrader -a ALPACA_PAPER_KEY_ID -w
# (-w with no value prompts for it, so the secret never lands in shell history)
#
# Lookup order for each name: environment variable, then .env, then Keychain (service "taylortrader").

ALPACA_PAPER_KEY_ID=
ALPACA_PAPER_SECRET_KEY=

# Live keys are only read when config mode = "live" AND TAYLORTRADER_ALLOW_LIVE=1 (the dashboard sets it when you type GO LIVE).
ALPACA_LIVE_KEY_ID=
ALPACA_LIVE_SECRET_KEY=
# TAYLORTRADER_ALLOW_LIVE=1

# Alerts (optional)
NTFY_TOPIC=
EMAIL_PASSWORD=
HEALTHCHECK_URL=

# AI strategy (optional): the key for the provider set in [ai] in config.toml.
# A local model (Ollama, LM Studio) needs no key: set [ai] endpoint instead.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
